[Unit]
Description=Resource monitor with HTTP access
Requires=docker.service course-storage.service
After=docker.service course-storage.service

[Service]
Type=simple
ExecStartPre=/usr/bin/mountpoint -q /mnt/logs
ExecStart=/usr/bin/docker start --attach my-app
ExecStop=/usr/bin/docker stop -t 10 my-app
Restart=on-failure
RestartSec=3
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
